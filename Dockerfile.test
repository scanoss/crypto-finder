# ============================================================================
# Test Docker Image
# ============================================================================
# This image is used for running integration tests in CI/CD and locally.
# It includes Go, python3-venv and cargo so the Python and Rust dependency
# reachability tests run in CI instead of skipping.

FROM golang:1.26@sha256:5c3f3f28a273c9b61698b2d34f18375929790ab1f1d3835d032d21e2b31eae0c

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3=3.13.5-1 \
    python3-pip=25.1.1+dfsg-1 \
    python3-venv=3.13.5-1 \
    cargo=1.85.1+dfsg1-1+deb13u1 \
    ca-certificates=20250419 \
    && rm -rf /var/lib/apt/lists/*

RUN go version

# The race runtime sleeps 1s before every process exit by default. Tests that
# re-exec the test binary as a fake scanner paid it once per run.
ENV GORACE=atexit_sleep_ms=0

# The checkout is bind-mounted from the host and owned by another user; tests
# that run git inside it (scripts/featuremap) need it marked safe.
RUN git config --system --add safe.directory /workspace

# Set working directory
WORKDIR /workspace

# Default command runs tests. The 30m timeout is headroom over go test's
# 10-minute per-package default, not an expected duration: the whole suite
# takes a few minutes under -race with coverage on 4 cores.
CMD ["go", "test", "-v", "-race", "-timeout", "30m", "-coverprofile=coverage.out", "-covermode=atomic", "./..."]
