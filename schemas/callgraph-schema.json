{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://scanoss.com/schemas/callgraph.json",
  "title": "SCANOSS Crypto-Finder Callgraph Export",
  "description": "Finding-centric reachability export written by --export-callgraph.",
  "type": "object",
  "required": [
    "schema_version",
    "scan_metadata",
    "finding_graphs"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "6.11",
      "type": "string",
      "description": "Version of the customer-facing callgraph contract."
    },
    "scan_metadata": {
      "$ref": "#/definitions/ScanMetadata"
    },
    "finding_graphs": {
      "type": "array",
      "description": "One reachability record per interim-report finding.",
      "items": {
        "$ref": "#/definitions/FindingGraph"
      }
    },
    "supporting_calls": {
      "type": "array",
      "description": "Lifecycle and context calls associated with findings.",
      "items": {
        "$ref": "#/definitions/SupportingCall"
      }
    },
    "crypto_entry_points": {
      "type": "array",
      "description": "Reverse-reachability index keyed by callable identity: every function from which a finding is reachable, deliberately broader than the exported call_chains. crypto_entry_points[].root marks the chain roots.",
      "items": {
        "type": "object",
        "properties": {
          "root": {
            "type": "boolean",
            "description": "True when this entry point is where a chain starts: the first root-module caller in dependency mode, or an in-degree-zero graph root in standalone mode."
          }
        }
      }
    }
  },
  "definitions": {
    "FindingGraph": {
      "type": "object",
      "required": [
        "finding_id"
      ],
      "properties": {
        "finding_id": {
          "type": "string"
        },
        "call_chains": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CallChain"
          }
        }
      },
      "additionalProperties": true
    },
    "CallChain": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/CallChainNode"
      }
    },
    "CallChainNode": {
      "type": "object",
      "required": [
        "function_name",
        "file_path"
      ],
      "properties": {
        "function_name": {
          "type": "string"
        },
        "file_path": {
          "type": "string"
        },
        "crypto_call": {
          "$ref": "#/definitions/CryptoCall"
        }
      },
      "additionalProperties": true
    },
    "CryptoCall": {
      "type": "object",
      "required": [
        "function_name",
        "line"
      ],
      "properties": {
        "function_name": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "parameter_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "parameter_roles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "resolved_key_length": {
          "$ref": "#/definitions/ResolvedKeyLength"
        }
      },
      "additionalProperties": true
    },
    "ResolvedKeyLength": {
      "type": "object",
      "required": [
        "provenance",
        "source_call"
      ],
      "properties": {
        "bits": {
          "type": "integer"
        },
        "provenance": {
          "type": "string",
          "enum": [
            "constant",
            "unknown"
          ]
        },
        "source_call": {
          "$ref": "#/definitions/SourceCall"
        }
      },
      "additionalProperties": false
    },
    "SourceCall": {
      "type": "object",
      "required": [
        "function_name",
        "line",
        "parameter_index"
      ],
      "properties": {
        "function_name": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "parameter_index": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "SupportingCall": {
      "type": "object",
      "required": [
        "supporting_id"
      ],
      "properties": {
        "supporting_id": {
          "type": "string"
        },
        "supporting_call": {
          "$ref": "#/definitions/CryptoCall"
        }
      },
      "additionalProperties": true
    },
    "ScanMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ecosystem": {
          "type": "string"
        },
        "root_module": {
          "type": "string"
        },
        "tool_name": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        },
        "exported_at": {
          "type": "string"
        },
        "function_count": {
          "type": "integer",
          "minimum": 0
        },
        "edge_count": {
          "type": "integer",
          "minimum": 0
        },
        "java_requested_jdk_major": {
          "type": "string"
        },
        "java_runtime_version": {
          "type": "string"
        },
        "java_platform_signatures_used": {
          "type": "boolean"
        },
        "java_platform_signature_source": {
          "type": "string"
        },
        "java_platform_signature_unavailable_reason": {
          "type": "string"
        }
      }
    }
  }
}
