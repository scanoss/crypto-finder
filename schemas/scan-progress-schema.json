{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://scanoss.com/schemas/scan-progress.json",
  "title": "SCANOSS Crypto-Finder Scan Progress Event",
  "description": "Version 1 JSONL event emitted by crypto-finder when structured progress is enabled.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event", "schema_version", "phase", "status"],
  "definitions": {
    "dependencyOutcomeList": {
      "description": "Dependencies the scan did not observe completely, sorted by module, version and purl. Its length equals the matching counter.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["module", "version", "reason"],
        "properties": {
          "module": {"type": "string", "minLength": 1},
          "version": {"type": "string"},
          "purl": {
            "description": "The package URL the dependency's findings carry in dependency_info.purl. Absent when the module has no package URL form.",
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "description": "Open set within v1: a consumer must accept an unrecognized reason.",
            "type": "string",
            "minLength": 1
          },
          "error_code": {
            "description": "The failure code of a failed dependency scan, when it has one.",
            "type": "string",
            "minLength": 1
          },
          "specifier": {
            "description": "A declared dependency the scan could not pin: its version specifier as the manifest writes it.",
            "type": "string",
            "minLength": 1
          },
          "markers": {
            "description": "A declared Python dependency the scan could not pin: its PEP 508 environment markers as written. Absent when unconditional.",
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  },
  "properties": {
    "event": {
      "const": "scan_progress"
    },
    "schema_version": {
      "const": "1"
    },
    "phase": {
      "enum": [
        "scan",
        "rules",
        "detection",
        "dependencies",
        "callgraph",
        "entry_points",
        "conditioned_findings",
        "finding_ids",
        "occurrence_keys",
        "oid_projection",
        "export",
        "output"
      ]
    },
    "status": {
      "enum": ["started", "completed", "failed", "canceled", "skipped"]
    },
    "parent_phase": {
      "enum": ["scan", "dependencies", "export"]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reason": {
          "enum": [
            "not_requested",
            "manifest_absent",
            "ecosystem_not_supported",
            "unsupported_lockfile"
          ]
        },
        "ecosystems": {
          "description": "On a completed dependencies event, the dependency ecosystems the phase resolved, sorted. Absent means not reported.",
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "ecosystems_skipped": {
          "description": "On a completed dependencies event, the ecosystems the phase saw in the target but did not resolve, sorted by ecosystem, each with a dependency skip reason (an open set like reason). Empty when none was. Absent means not reported.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ecosystem", "reason"],
            "properties": {
              "ecosystem": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        },
        "ecosystem": {
          "description": "On a skipped dependencies event, the dependency ecosystem the skip reason is about: java for manifest_absent, the ecosystem the target declares its dependencies in for ecosystem_not_supported. Absent for not_requested.",
          "type": "string",
          "minLength": 1
        },
        "deps_scanned": {
          "description": "On a completed dependencies event, the dependencies the SCANOSS API answered with their findings. No dependency is scanned locally.",
          "type": "integer",
          "minimum": 0
        },
        "deps_skipped": {
          "description": "On a completed dependencies event, the dependencies the SCANOSS API holds no reachability data for (deps_skipped_list names them, reason no_reachability_data, error_code the API's info code): their findings are missing.",
          "type": "integer",
          "minimum": 0
        },
        "deps_failed": {
          "type": "integer",
          "minimum": 0
        },
        "deps_incomplete": {
          "type": "integer",
          "minimum": 0
        },
        "deps_skipped_list": {
          "$ref": "#/definitions/dependencyOutcomeList"
        },
        "deps_failed_list": {
          "$ref": "#/definitions/dependencyOutcomeList"
        },
        "deps_incomplete_list": {
          "$ref": "#/definitions/dependencyOutcomeList"
        },
        "files_incomplete": {
          "type": "integer",
          "minimum": 0
        },
        "unsupported_languages": {
          "description": "On a completed detection event, the target's languages this version does not detect cryptography in, sorted. Absent when there is none.",
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "deps_with_findings": {
          "type": "integer",
          "minimum": 0
        },
        "total_dep_findings": {
          "type": "integer",
          "minimum": 0
        },
        "dep_findings_reachable": {
          "description": "On a completed dependencies event, the dependency findings the SCANOSS API found the project reaches.",
          "type": "integer",
          "minimum": 0
        },
        "dep_findings_unknown": {
          "description": "On a completed dependencies event, the dependency findings whose reachability the SCANOSS API could not decide.",
          "type": "integer",
          "minimum": 0
        },
        "dep_findings_unreachable": {
          "description": "On a completed dependencies event, the dependency findings the SCANOSS API found the project does not reach.",
          "type": "integer",
          "minimum": 0
        },
        "request_bytes": {
          "description": "On a completed dependencies event, the size of the application reachability request.",
          "type": "integer",
          "minimum": 0
        },
        "response_bytes": {
          "description": "On a completed dependencies event, the size of the application reachability response.",
          "type": "integer",
          "minimum": 0
        },
        "request_call_site_count": {
          "description": "On a completed dependencies event, the project's calls into its dependencies the request carried.",
          "type": "integer",
          "minimum": 0
        },
        "request_function_count": {
          "description": "On a completed dependencies event, the project functions holding those calls.",
          "type": "integer",
          "minimum": 0
        },
        "reachability_info_code": {
          "description": "On a completed dependencies event, the SCANOSS API's status code for the application reachability answer (READY when every dependency had data).",
          "type": "string"
        },
        "reachability_info_message": {
          "description": "On a completed dependencies event, the SCANOSS API's status message for the answer.",
          "type": "string"
        }
      },
      "oneOf": [
        {
          "required": ["reason"],
          "not": {
            "anyOf": [
              {"required": ["deps_scanned"]},
              {"required": ["deps_skipped"]},
              {"required": ["deps_failed"]},
              {"required": ["deps_incomplete"]},
              {"required": ["deps_with_findings"]},
              {"required": ["total_dep_findings"]},
              {"required": ["files_incomplete"]},
              {"required": ["deps_skipped_list"]},
              {"required": ["deps_failed_list"]},
              {"required": ["deps_incomplete_list"]},
              {"required": ["ecosystems"]},
              {"required": ["ecosystems_skipped"]}
            ]
          }
        },
        {
          "required": [
            "deps_scanned",
            "deps_skipped",
            "deps_failed",
            "deps_with_findings",
            "total_dep_findings"
          ],
          "not": {
            "anyOf": [
              {"required": ["reason"]},
              {"required": ["ecosystem"]},
              {"required": ["files_incomplete"]}
            ]
          }
        },
        {
          "required": ["files_incomplete"],
          "not": {
            "anyOf": [
              {"required": ["reason"]},
              {"required": ["ecosystem"]},
              {"required": ["deps_scanned"]},
              {"required": ["deps_skipped"]},
              {"required": ["deps_failed"]},
              {"required": ["deps_incomplete"]},
              {"required": ["deps_with_findings"]},
              {"required": ["total_dep_findings"]},
              {"required": ["deps_skipped_list"]},
              {"required": ["deps_failed_list"]},
              {"required": ["deps_incomplete_list"]},
              {"required": ["ecosystems"]},
              {"required": ["ecosystems_skipped"]}
            ]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["status"],
        "properties": {
          "status": {
            "enum": ["started", "skipped"]
          }
        }
      },
      "then": {
        "not": {
          "required": ["duration_ms"]
        }
      }
    },
    {
      "if": {
        "required": ["status"],
        "properties": {
          "status": {
            "const": "skipped"
          }
        }
      },
      "then": {
        "required": ["phase", "details"],
        "properties": {
          "phase": {
            "enum": ["dependencies", "export"]
          },
          "details": {
            "required": ["reason"]
          }
        }
      }
    },
    {
      "if": {
        "required": ["phase", "status"],
        "properties": {
          "phase": {
            "const": "dependencies"
          },
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "required": ["details"],
        "properties": {
          "details": {
            "required": [
              "deps_scanned",
              "deps_skipped",
              "deps_failed",
              "deps_with_findings",
              "total_dep_findings"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": ["details"],
        "properties": {
          "details": {
            "required": ["reason"]
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "skipped"
          }
        }
      }
    },
    {
      "if": {
        "required": ["details"],
        "properties": {
          "details": {
            "required": [
              "deps_scanned",
              "deps_skipped",
              "deps_failed",
              "deps_with_findings",
              "total_dep_findings"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "phase": {
            "const": "dependencies"
          },
          "status": {
            "const": "completed"
          }
        }
      }
    },
    {
      "if": {
        "required": ["details"],
        "properties": {
          "details": {
            "required": ["files_incomplete"]
          }
        }
      },
      "then": {
        "properties": {
          "phase": {
            "const": "detection"
          },
          "status": {
            "const": "completed"
          }
        }
      }
    },
    {
      "if": {
        "required": ["phase"],
        "properties": {
          "phase": {
            "const": "callgraph"
          }
        }
      },
      "then": {
        "required": ["parent_phase"],
        "properties": {
          "parent_phase": {
            "enum": ["dependencies", "export"]
          }
        }
      }
    },
    {
      "if": {
        "required": ["phase"],
        "properties": {
          "phase": {
            "enum": ["rules", "detection", "dependencies", "export", "output"]
          }
        }
      },
      "then": {
        "required": ["parent_phase"],
        "properties": {
          "parent_phase": {
            "const": "scan"
          }
        }
      }
    },
    {
      "if": {
        "required": ["phase"],
        "properties": {
          "phase": {
            "enum": ["entry_points", "conditioned_findings", "finding_ids", "occurrence_keys", "oid_projection"]
          }
        }
      },
      "then": {
        "required": ["parent_phase"],
        "properties": {
          "parent_phase": {
            "enum": ["scan", "export"]
          }
        }
      }
    },
    {
      "if": {
        "required": ["phase"],
        "properties": {
          "phase": {
            "const": "scan"
          }
        }
      },
      "then": {
        "not": {
          "required": ["parent_phase"]
        }
      }
    }
  ]
}
